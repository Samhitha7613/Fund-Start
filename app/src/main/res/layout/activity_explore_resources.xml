<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@drawable/background"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/headerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Explore Startup Resources"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/fundingGuideText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📘 Funding Guide"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/legalComplianceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📑 Legal &amp; Compliance Help"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/pitchDeckExamplesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯 Pitch Deck Examples"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/mentorshipNetworkingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤝 Mentorship &amp; Networking"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/freeStartupToolsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛠️ Free Startup Tools"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</ScrollView>
