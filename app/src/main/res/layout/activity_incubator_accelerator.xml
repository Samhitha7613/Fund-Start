<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            android:title="Incubators &amp; Accelerators" />

        <TextView
            android:id="@+id/incubatorAcceleratorDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Incubators and accelerators are organizations designed to help startups grow by providing resources, mentorship, and funding. While both offer valuable support, accelerators focus on fast growth and scaling, while incubators provide long-term support for businesses from their inception."
            android:textSize="16sp"
            android:layout_marginTop="24dp" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:src="@drawable/img_11"
            android:scaleType="fitXY"
            android:layout_gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Key Features of Incubators &amp; Accelerators"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Incubators provide long-term support, office space, and mentoring, often without taking equity. Accelerators focus on short-term, high-impact programs aimed at rapid growth and often take equity in exchange for funding."
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Incubator vs Accelerator"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Incubator Features:\n• Long-term (1-3 years) support\n• Minimal equity taken\n• Tailored support\n\nAccelerator Features:\n• Short-term (3-6 months)\n• Requires equity\n• Focus on rapid scaling"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Benefits"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Incubators provide valuable support over a longer period, while accelerators help businesses grow rapidly through a structured, intensive program."
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="How to Join?"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="1. Research different incubators and accelerators.\n2. Apply with your business plan and pitch.\n3. Get selected and participate in the program."
            android:textSize="16sp" />
        <Space
            android:layout_width="match_parent"
            android:layout_height="100dp"/>

    </LinearLayout>
</ScrollView>
